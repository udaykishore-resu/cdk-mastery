{
  "name": "cdk-mastery",
  "version": "1.0.0",
  "private": true,
  "description": "Production mastery of AWS CDK and CDK for Terraform (GCP): 24 runnable modules, two capstones, one shared construct library, tests for everything.",
  "workspaces": [
    "shared",
    "aws-cdk",
    "cdktf-gcp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "synth": "npm run synth --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "rm -rf aws-cdk/cdk.out cdktf-gcp/cdktf.out */dist */*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
